# Default site (optional static files on :80).
:80 {
	file_server
}

# CDN entry — Cloudflare-fronted. Set CDN_DOMAIN and CDN_PATH in .env.
# Cloudflare IP ranges: https://api.cloudflare.com/client/v4/ips (2026-11-02).
https://{$CDN_DOMAIN}:8443 {
	tls /etc/origin/fullchain.crt /etc/origin/private.key {
		protocols tls1.2 tls1.3
	}
	@not_cf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	respond @not_cf "Forbidden" 403
	@entry path {$CDN_PATH} {$CDN_PATH}*
	handle @entry {
		reverse_proxy 127.0.0.1:10086 {
			flush_interval -1
			transport http {
				versions h2c
			}
		}
	}
	handle {
		respond 404
	}
}
