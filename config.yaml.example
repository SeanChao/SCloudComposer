domain:
vless_id:
reality:
  enabled: false
  # Run ./setup.sh reality-init to generate and persist these values locally.
  port: 8443
  vless_id:
  private_key:
  public_key:
  # REALITY camouflage target. Must negotiate TLS 1.3 + X25519 and complete the
  # handshake when relayed by REALITY. Avoid www.microsoft.com: it sits behind an
  # Akamai edge that fails the REALITY handshake relay (clients get
  # "handshake did not complete successfully"). www.apple.com works well.
  # serverName (client SNI) and dest should point at the same real host.
  server_name: "www.apple.com"
  dest: "www.apple.com:443"
  short_id_count: 10
  short_ids: []